# ── Secrets & environment ──────────────────────────────────────────────────────
.env
*.env
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python
pip-wheel-metadata/
site-packages/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── PostgreSQL data ───────────────────────────────────────────────────────────
# The postgres_data/ directory contains a live DB — never commit it
postgres_data/

# ── TLS / certbot runtime (Let's Encrypt certs & keys) ────────────────────────
certbot/

# ── Database dumps (data, not source) ─────────────────────────────────────────
*.dump

# ── Model weights (never commit; one 68 MB adapter is still in old history) ───
*.safetensors
*.bin
*.pt
*.pth

# ── Jupyter / notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs & temp files ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig

# ── Generated indexes (rebuilt from DB) ───────────────────────────────────────
RAG/name_index.json

# ── Embedding cache written by RAG/yaml_to_llamaindex.py ──────────────────────
RAG/embed_*.npz
RAG/embed_*.json

# ── Benchmark working data (pools, judging runs, downloads; large) ────────────
benchmarks/*/work/

# ── UI screenshots taken during development ───────────────────────────────────
/screenshot_*.png

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── Tool scratch directories ──────────────────────────────────────────────────
.agents/
.aws/
.codex/
