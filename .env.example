# Copy this to .env and fill in your values.

# ── Gemini API ─────────────────────────────────────────────────────────────────
# Required for text-to-SQL (preprocessing + SQL generation + error correction)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Anthropic API (optional) ────────────────────────────────────────────────────
# Cross-provider fallback tier: used only when all Gemini models fail (e.g. 503).
# If unset, the cascade is Gemini-only. Default fallback model: claude-sonnet-4-6.
ANTHROPIC_API_KEY=
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
# GEMINI_MODEL_CASCADE=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite,gemini-2.0-flash
# Seed of every Gemini call (default 0, so repeated questions repeat); "none" sends none.
# GEMINI_SEED=0

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
METADATA_DB_NAME=bids_sql
METADATA_DB_USER=user
METADATA_DB_PASSWORD=password
METADATA_DB_HOST=db        # use 'localhost' when running outside Docker
METADATA_DB_PORT=5432
# Local docker-compose.yml only: a host directory for the Postgres data
# (default: the named volume postgres-bids-data).
# POSTGRES_DATA=./postgres_data

# ── Authentication ─────────────────────────────────────────────────────────────
# GitHub OAuth App credentials (create one at https://github.com/settings/developers)
# Callback URL to register in the GitHub OAuth App: https://<your-domain>/api/auth/github/callback
# The backend refuses to start while either is missing.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Who may sign in. Exactly one of the two, or the backend refuses to start:
#   GITHUB_ORG=<org>             only members of that GitHub organization
#   ALLOW_ANY_GITHUB_USER=true   every GitHub account
# A blank GITHUB_ORG alone does NOT open the site; that has to be asked for.
# If the organization restricts third-party application access (its Settings ->
# Third-party Access), an owner has to approve this OAuth App there. Until
# then GitHub answers the membership check with 403 and members cannot sign in
# ("GitHub could not confirm the organization membership").
GITHUB_ORG=
ALLOW_ANY_GITHUB_USER=false
# The OAuth callback URL, as registered in the OAuth App. Set it in production:
# behind a proxy that ends TLS or rewrites the host, the URL inferred from the
# request can come out as http:// or on the wrong host. Unset is fine for local dev.
GITHUB_REDIRECT_URI=
# Signs the HttpOnly login and CSRF cookies. The backend refuses to start while
# this is missing or shorter than 32 characters, as the placeholder is.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me-before-deploying
# Only needed if a frontend on ANOTHER origin calls this API: that one origin then
# gets credentialed CORS (e.g. https://bids-eye.yourdomain.com). Leave it * when
# the frontend and /api share one origin (the nginx setup): no CORS at all then.
# After login the browser returns to / on the host that handled the callback.
FRONTEND_URL=*

# ── App behaviour ──────────────────────────────────────────────────────────────
IN_PRODUCTION=false        # set to 'true' in production
# Searches per user per UTC day (the SEARCH category's daily window in
# backend/security/rate_limits.py; the per-minute budgets of all categories are set there)
DAILY_MESSAGE_LIMIT=20
# Comma-separated GitHub logins exempt from the daily search cap (not from the per-minute limits)
ADMIN_GITHUB_LOGINS=paul188

# ── OpenNeuro crawler ──────────────────────────────────────────────────────────
# Comma-separated accession IDs to crawl (overrides accessions.yaml)
OPENNEURO_ACCESSIONS=ds000001,ds000002

# How often to re-run the full crawl cycle (hours)
CRAWL_INTERVAL_HOURS=1

# Sleep between consecutive datasets (seconds) — keep this ≥ 10 to be polite
CRAWL_DELAY_SECONDS=30

# Answer a question that was asked before with its stored translation, with no
# model call (backend/services/stores/interpretations.py). Off by default.
# INTERPRETATION_CACHE=true

# Feature switches like the one above (backend/services/switches.py) are true
# or false; any other value stops the backend at startup.

# Backend log lines: text (the default) or json, one object per line
# (backend/request_log.py). docker-compose-prod.yml sets json.
# LOG_FORMAT=json
